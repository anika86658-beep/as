{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Organic store product item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "bnName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryLabel": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountBadge": { "type": "string", "maxLength": 50 },
        "weight": { "type": "string", "maxLength": 50 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "description": { "type": "string", "maxLength": 5000 },
        "image": { "type": "string", "maxLength": 1000 },
        "insideDhakaFee": { "type": "number" },
        "outsideDhakaFee": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Store category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "key": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "bnName": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 50 },
        "count": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placement record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 20 },
        "altPhone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 1000 },
        "city": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "upazila": { "type": "string", "maxLength": 100 },
        "deliveryArea": { "type": "string", "maxLength": 50 },
        "deliveryFee": { "type": "number" },
        "subtotal": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "trxId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "orderNumber", "customerName", "phone", "address", "totalAmount"]
    },
    "WorkTask": {
      "title": "WorkTask",
      "description": "Operational packaging and processing task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 255 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "assignedTo": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "progress": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 50 },
        "relatedOrderId": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and social links",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "whatsappNumber": { "type": "string", "maxLength": 50 }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public organic products catalog"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Product categories configuration"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/tasks/{taskId}": {
      "schema": "WorkTask",
      "description": "Internal packaging and dispatch tasks"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store profile and contact information"
    }
  }
}
